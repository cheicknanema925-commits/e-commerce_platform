# Copie ce fichier en .env et remplis les vraies valeurs.
# Le fichier .env n'est JAMAIS commité (il est dans .gitignore).
# Il est lu par docker compose ET par l'API en profil dev.

# Base de données PostgreSQL
POSTGRES_DB=boutique
POSTGRES_USER=boutique
POSTGRES_PASSWORD=change-moi
DB_HOST=localhost
DB_PORT=5432

# Sécurité
# Clé de signature des JWT (au moins 32 caractères) : openssl rand -hex 32
JWT_SECRET=
# Premier compte administrateur, créé au démarrage s'il n'existe pas (laisser vide pour ne rien créer)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Keycloak (optionnel) : docker compose --profile keycloak up -d
# Mot de passe de la console d'administration Keycloak (utilisateur « admin ») : http://localhost:8180
KEYCLOAK_ADMIN_PASSWORD=
# Mot de passe des comptes de démonstration créés par keycloak/demo-users.sh
KEYCLOAK_DEMO_PASSWORD=
# Laisser vide pour désactiver Keycloak côté API
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/boutique
